# .env.example
# SouthGold School Portal - Environment Configuration Template

# ---------------- Supabase Configuration ----------------
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<SUPABASE_PUBLISHABLE_KEY>
SUPABASE_JWKS_URL=https://<PROJECT_REF>.supabase.co/auth/v1/.well-known/jwks.json
NEXT_PUBLIC_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<SUPABASE_PUBLISHABLE_KEY>

# Direct Postgres connection string (required for automated direct schema migrations on boot)
# Format: postgresql://postgres:<DB_PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:<DB_PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres

# Server-only secrets. Do not commit real values.
SUPABASE_SECRET_KEY=<SUPABASE_SERVICE_ROLE_OR_SECRET_KEY>

# Optional account setup values. Do not commit real passwords.
SUPER_ADMIN_BOOTSTRAP_PASSWORD=<INITIAL_SUPER_ADMIN_PASSWORD>
DEFAULT_PORTAL_USER_PASSWORD=<INITIAL_PARENT_STUDENT_PASSWORD>
STAFF_PASSWORD_RESET_DEFAULT=<ADMIN_RESET_PASSWORD>

# ---------------- SMTP Configuration ----------------
# Standard SMTP variables for email deliveries (tickets/inquiries routing).
SMTP_HOST=<SMTP_HOST>
SMTP_PORT=<SMTP_PORT>
SMTP_USER=<SMTP_USER>
SMTP_PASSWORD=<SMTP_PASSWORD>
SMTP_FROM=<SMTP_FROM_EMAIL>
